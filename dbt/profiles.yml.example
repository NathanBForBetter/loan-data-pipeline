# Copy the loan_analytics block into ~/.dbt/profiles.yml.
# dev runs against the local DuckDB file; prod runs against BigQuery.
loan_analytics:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: ../data/loan_dev.duckdb
      threads: 4

    prod:
      type: bigquery
      method: oauth
      project: "{{ env_var('GCP_PROJECT', 'your-gcp-project-id') }}"
      dataset: analytics
      location: US
      threads: 4